{
  "name": "ninthpass",
  "version": "2.0.0",
  "description": "Ninth Pass: prompt-engineering skills with a durable Compose, Judge and Revise pipeline, installable and runnable from the command line.",
  "type": "module",
  "bin": {
    "ninthpass": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills/**/*.md",
    "skills/**/*.py",
    "README.md",
    "LICENSE",
    "PLAN.md",
    "TEST-RESULTS.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "prompt-engineering",
    "prompts",
    "prompt-optimization",
    "llm",
    "ai",
    "agents",
    "claude",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andymccutcheon/ninthpass.git"
  },
  "bugs": "https://github.com/andymccutcheon/ninthpass/issues",
  "homepage": "https://github.com/andymccutcheon/ninthpass#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:helpers": "python3 -B -m unittest discover -s tests -p '*_test.py' -v",
    "test:types": "tsc -p tsconfig.tests.json",
    "test:package": "node scripts/package-smoke.mjs",
    "test:live": "node dist/cli.js test --live --worker opencode",
    "check": "npm run build && npm run test:types && npm run test:coverage && npm run test:helpers",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
